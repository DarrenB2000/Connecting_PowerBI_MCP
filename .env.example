# Required: Claude API Key
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-...

# Optional: Claude Model (defaults to claude-sonnet-4-5 for cost efficiency)
# Other options: claude-opus-4-6 (more capable but expensive), claude-haiku-4-5 (faster/cheaper)
# CLAUDE_MODEL=claude-sonnet-4-5

# Authentication Option 1: Use default/public client ID (recommended for MVP)
# If you're using device code flow with Microsoft's default client, you may not need these.
# The app will attempt to use common tenant and discover the client ID.

# Authentication Option 2: Custom Azure App Registration
# If you created your own Azure AD app registration, uncomment and fill these in:
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: PowerBI MCP Server URL (defaults to Microsoft's official endpoint)
# POWERBI_MCP_URL=https://api.fabric.microsoft.com/v1/mcp/powerbi

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
